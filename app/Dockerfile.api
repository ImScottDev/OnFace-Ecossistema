FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY src/api-server ./src/api-server
COPY src/lib ./src/lib
COPY package.json ./
RUN npm install --no-save esbuild && \
    npx esbuild src/api-server/index.ts \
    --bundle --platform=node --format=esm --outdir=dist \
    --packages=external --alias:@=./src --target=node22

FROM node:22-alpine AS runner
RUN apk add --no-cache ffmpeg
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY package.json ./
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 api --ingroup nodejs
RUN mkdir -p /app/public/uploads && chown api:nodejs /app/public/uploads
USER api
EXPOSE 3001
ENV API_PORT=3001
CMD ["node", "dist/index.js"]
