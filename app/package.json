{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed-servicos": "tsx src/lib/db/seed-servicos.ts",
    "db:cleanup-seed": "tsx src/lib/db/cleanup-seed.ts",
    "db:relatorio-duplicidade-contratos": "tsx --env-file=.env src/lib/db/relatorio-duplicidade-contratos.ts",
    "db:relatorio-data-quality": "tsx --env-file=.env src/lib/db/relatorio-data-quality.ts",
    "check:relatorios": "tsx --env-file=.env src/scripts/checar-invariantes-relatorios.ts",
    "check:pre-deploy": "tsx --env-file-if-exists=.env src/scripts/checar-pre-deploy.ts",
    "catalogo:sync": "tsx --env-file=.env src/scripts/sincronizar-catalogo-stripe.ts",
    "catalogo:sync:dry": "tsx --env-file=.env src/scripts/sincronizar-catalogo-stripe.ts --dry-run",
    "test": "node --import tsx --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "test:ai-platform": "node --import tsx --test \"src/lib/ai-platform/**/*.test.ts\" \"src/lib/automations/**/*.test.ts\"",
    "smoke:claude-subscription": "tsx --env-file-if-exists=.env src/scripts/smoke-claude-subscription.ts",
    "ds:check": "node scripts/verificar-design-system.mjs",
    "ds:strict": "node scripts/verificar-design-system.mjs --strict",
    "ds:contraste": "node scripts/verificar-contraste.mjs",
    "ds:all": "node scripts/verificar-contraste.mjs --strict && node scripts/verificar-design-system.mjs",
    "aceite:won-cs": "tsx --env-file=.env src/scripts/aceite-won-cs.ts",
    "check:env": "tsx src/scripts/checar-env.ts",
    "db:migrar": "tsx --env-file=.env src/lib/db/migrar.ts",
    "db:migrar:check": "tsx --env-file=.env src/lib/db/migrar.ts --check",
    "aceite:contrato": "tsx --env-file=.env src/scripts/aceite-contrato-assinado.ts",
    "aceite:vendas": "tsx --env-file=.env src/scripts/aceite-vendas.ts",
    "check:vendas": "tsx --env-file=.env src/scripts/checar-vendas-dominio.ts && tsx --env-file=.env src/scripts/checar-vendas-consultas.ts",
    "posvenda:reprocessar": "tsx --env-file=.env src/scripts/reprocessar-pos-venda.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@auth/core": "0.41.3",
    "@azure/msal-node": "^5.0.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.19.11",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@onface/acquisition": "workspace:*",
    "@onface/catalog": "workspace:*",
    "@onface/identity": "workspace:*",
    "@onface/integrations-callface-ai": "workspace:*",
    "@onface/integrations-meta": "workspace:*",
    "@onface/platform-database": "workspace:*",
    "@onface/platform-events": "workspace:*",
    "@onface/platform-storage": "workspace:*",
    "@onface/sales": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@types/sanitize-html": "^2.16.1",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.35.1",
    "googleapis": "^171.4.0",
    "hono": "^4.12.8",
    "imapflow": "^1.2.13",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.8",
    "puppeteer": "^24.40.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  }
}
