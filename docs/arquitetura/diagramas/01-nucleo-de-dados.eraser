// Relacoes reais (chaves estrangeiras do banco).
aquisicoes.empresa_id > empresas.id
aquisicoes.etapa_id > pipeline_etapas.id
aquisicoes.pessoa_id > pessoas.id
aquisicoes.responsavel_id > usuarios.id
assinaturas.contrato_id > contratos.id
assinaturas.empresa_id > empresas.id
assinaturas.lead_id > leads.id
