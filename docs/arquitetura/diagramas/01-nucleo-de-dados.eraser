propostas.criado_por_id > usuarios.id
propostas.empresa_id > empresas.id
propostas.lead_id > leads.id
propostas.negocio_id > negocios.id
propostas.oportunidade_id > oportunidades.id
propostas.substituida_por_id > propostas.id
servicos_canonicos.contrato_id > contratos.id
servicos_canonicos.empresa_id > empresas.id
servicos_canonicos.lead_id > leads.id
servicos_canonicos.oportunidade_origem_id > oportunidades.id

// A ponte INVISIVEL do cutover.
// pessoas.lead_id_legado e oportunidades.negocio_id_legado SAO chave
// estrangeira e ja aparecem acima. Esta nao e: `aquisicoes.lead_legado_id`
// e so convencao, entao nenhuma ferramenta que leia o banco a mostra —
// e e justamente a ponte da aquisicao, a entrada de todo lead.
aquisicoes.lead_legado_id > leads.id
