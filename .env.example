# ═══════════════════════════════════════════
# Callface | CRM 2.0 — variáveis de ambiente
# ═══════════════════════════════════════════
#
# Mantido em dia por `npm run check:env` (app/), que compara este arquivo com
# o que o código de fato lê e falha se aparecer variável nova sem documentar.
#
# Legenda:
#   [OBRIGATÓRIA]  sem ela o sistema não sobe ou uma jornada crítica para
#   [FAIL-CLOSED]  sem ela o endpoint RECUSA tudo (de propósito — ver abaixo)
#   [opcional]     desliga só a funcionalidade correspondente

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=production
COMPOSE_PROJECT_NAME=callface-crm

# ─── Banco e cache ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB_NAME   # [OBRIGATÓRIA]
MIGRATIONS_DIR=                  # [opcional] pasta dos .sql; na imagem é /repo/app/dist/migrations
DB_NAME=callface_crm
DB_USER=callface
DB_PASSWORD=
DB_POOL_SIZE=15                  # [opcional] pool do postgres-js (default 15)
REDIS_URL=redis://redis:6379     # [OBRIGATÓRIA] filas e schedulers do worker

# ─── Portas dos processos ────────────────────────────────────────────────────
APP_PORT=3000
API_PORT=3001                    # container `api` (Hono). Default do código: 3001
WORKER_HEALTH_PORT=3002          # [OBRIGATÓRIA em compose] precisa bater com o healthcheck do worker

# ─── Autenticação (NextAuth v5) ──────────────────────────────────────────────
# NEXTAUTH_SECRET é o que o api-server usa pra decodificar o cookie de sessão:
# se divergir entre app e api, o CRM autentica no Next e dá 401 em toda chamada.
AUTH_SECRET=                     # [OBRIGATÓRIA] openssl rand -base64 32
NEXTAUTH_SECRET=                 # [OBRIGATÓRIA] mesmo valor de AUTH_SECRET
AUTH_URL=https://crm.callface.io
NEXTAUTH_URL=https://crm.callface.io   # [OBRIGATÓRIA] usada em link de proposta/contrato
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://crm.callface.io   # [opcional] base pública usada no frontend

# ─── Webhooks: TODOS fail-closed ─────────────────────────────────────────────
# Sem o segredo, o endpoint responde 503 e NÃO processa. É intencional: um
# webhook sem verificação aceita payload forjado de qualquer origem (14/09 três
# deles estavam assim). Ao subir um ambiente novo, configure os quatro abaixo
# ANTES de apontar os provedores, senão lead, mensagem e pagamento não entram.
STRIPE_WEBHOOK_SECRET=           # [FAIL-CLOSED] "Signing secret" (whsec_...) do endpoint no painel Stripe
CALLFACE_WEBHOOK_SECRET=         # [FAIL-CLOSED] header X-Callface-Signature (webhook de saída da Callface)
DOCUMENSO_WEBHOOK_SECRET=        # [FAIL-CLOSED] header x-documenso-secret
UAZAPI_WEBHOOK_SECRET=           # [FAIL-CLOSED] HMAC do webhook do WhatsApp (x-hmac-signature)
RD_WEBHOOK_SECRET=               # [FAIL-CLOSED] ?token= do webhook de lead do RD Station
META_LEADIDS_WEBHOOK_SECRET=     # [FAIL-CLOSED] ?token= do webhook de lead ids da Meta
APOLLO_WEBHOOK_SECRET=           # [FAIL-CLOSED] ?token= do webhook de enriquecimento do Apollo

# ─── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_API_KEY=                  # [OBRIGATÓRIA p/ billing] restricted key de leitura (sync de assinatura/fatura)
STRIPE_SECRET_KEY=               # [OBRIGATÓRIA p/ checkout] chave de escrita (checkout + invoice)
STRIPE_API_VERSION=              # [opcional] fixa a versão da API
STRIPE_CHECKOUT_MODE=mock        # mock | live — em dev fica mock, nunca cobra cliente real
STRIPE_PORTAL_CONFIGURATION_ID=  # [opcional] configuração do portal do cliente; sem ela usa a padrão da conta
STRIPE_PORTAL_PRIVACY_URL=       # [opcional] link de privacidade exibido no portal do cliente
STRIPE_PORTAL_TERMS_URL=         # [opcional] link de termos exibido no portal do cliente
ALLOW_STRIPE_LIVE_CHECKOUT=      # trava extra: precisa ser explícito pra cobrar de verdade
CHECKOUT_SUCCESS_URL=            # [opcional] retorno do checkout (default deriva de NEXTAUTH_URL)
CHECKOUT_CANCEL_URL=

# ─── Assinatura de contrato (Documenso self-hosted) ──────────────────────────
DOCUMENSO_API_URL=https://sign.callface.io/api/v2
DOCUMENSO_API_TOKEN=             # [OBRIGATÓRIA p/ PABX e White Label] sem ela cai no aceite eletrônico simples

# ─── Telefonia Callface ──────────────────────────────────────────────────────
CALLFACE_INBOUND_TOKEN=          # token de entrada aceito pela plataforma
CALLFACE_CREATE_CONTACT_URL=     # endpoint de criação de contato/discagem

# ─── WhatsApp (wuzapi) ───────────────────────────────────────────────────────
UAZAPI_BASE_URL=http://wuzapi:8080
UAZAPI_API_KEY=
UAZAPI_SESSION_NAME=
WUZAPI_ADMIN_TOKEN=              # openssl rand -hex 16
WUZAPI_GLOBAL_HMAC_KEY=
WHATSAPP_ALLOWLIST=              # fora de produção: só estes números recebem mensagem

# ─── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_ENCRYPTION_KEY=            # [OBRIGATÓRIA p/ e-mail] openssl rand -hex 32 — cifra o token das contas conectadas
RESEND_API_KEY=                  # [opcional] e-mail transacional (proposta, contrato, cadência)
RESEND_FROM=                     # remetente verificado no Resend
EMAIL_LOGO_URL=                  # logo usada nos templates
NEXT_PUBLIC_SMTP_CONFIGURED=     # sinaliza pro frontend que há envio configurado

# ─── OAuth de caixa de e-mail e agenda ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ATENÇÃO: MICROSOFT_CLIENT_SECRET é secret real compartilhado com produção
# (ver CLAUDE.md) — nunca gerar token novo com esse valor em ambiente local.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Segredo (clientState) das change notifications do calendário. Gere com `openssl rand -hex 32`.
# Sem ele a rota /api/webhooks/microsoft-calendar recusa tudo e a volta Outlook -> ONFACE fica só na delta (5 min).
MICROSOFT_CALENDAR_CLIENT_STATE=

# ─── Marketing e enriquecimento ──────────────────────────────────────────────
APOLLO_API_KEY=                  # fallback; a chave por organização fica em organizacoes.apollo_api_key
# Meta: TRÊS credenciais, não uma. Medido contra a Graph API em 21/09/2026: o
# token da CAPI tem só `read_ads_dataset_quality` e a Meta recusa insights com
# ele (erro 200, "Ad account owner has NOT grant ads_management or ads_read").
# Reaproveitar um token para tudo faz a integração falhar em produção com um
# erro que parece de configuração de conta.
#
#   CAPI          enviar conversão       META_CAPI_ACCESS_TOKEN
#   Lead Ads      ler o lead do form     META_LEADS_ACCESS_TOKEN + META_PAGE_ID
#   Ads Insights  ler gasto e resultado  META_ADS_ACCESS_TOKEN (ads_read)

# ── Meta: CAPI (conversões de volta) ──
META_PIXEL_ID=                   # Pixel/Dataset ID — mesmo número, mesmo endpoint /{id}/events
META_CAPI_ACCESS_TOKEN=          # [SEGREDO] System User do app de Conversions API
META_CAPI_TEST_EVENT_CODE=       # [opcional] manda para a aba Test Events em vez de contar como conversão real

# ── Meta: Lead Ads (entrada direta) ──
META_APP_ID=
META_APP_SECRET=                 # [SEGREDO][FAIL-CLOSED] valida X-Hub-Signature-256 do webhook
META_WEBHOOK_VERIFY_TOKEN=       # [SEGREDO] handshake do webhook; gere com `openssl rand -base64 48`
META_PAGE_ID=                    # página dona do formulário de Lead Ads
META_LEADS_ACCESS_TOKEN=         # [SEGREDO] precisa de leads_retrieval na página; SEM ELE o lead chega sem e-mail nem telefone
META_WEBHOOK_ORG_SLUG=           # [opcional] organização que recebe o lead; default scott-studio

# ── Meta: Ads Insights (gasto, CPL, ROAS) ──
META_AD_ACCOUNT_ID=              # com ou sem o prefixo act_ — o código normaliza
META_ADS_ACCESS_TOKEN=           # [SEGREDO] escopo ads_read ou ads_management
META_ACCESS_TOKEN=               # nome antigo de META_ADS_ACCESS_TOKEN; ainda aceito
META_API_VERSION=                # [opcional] default v26.0, validado contra a Graph API

# ── Armazenamento de arquivos (SPEC §32) ──
# Em produção, SEM estas variáveis o serviço FALHA em vez de cair no disco
# local: cair em silêncio é como o produto chegou a guardar arquivo na máquina.
STORAGE_ENDPOINT=                # S3, R2 ou compatível
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=           # [SEGREDO]
STORAGE_SECRET_ACCESS_KEY=       # [SEGREDO]
STORAGE_REGION=                  # [opcional] default auto
STORAGE_PATH_STYLE=              # [opcional] "false" para S3 clássico; default caminho (R2, MinIO)
GOOGLE_ADS_CUSTOMER_ID=          # tela de Integrações ainda marca como "em breve"
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REFRESH_TOKEN=

# ─── IA ──────────────────────────────────────────────────────────────────────
AI_CREDENTIALS_ENCRYPTION_KEY=   # [OBRIGATÓRIA p/ AI Platform] openssl rand -hex 32 — cifra credencial de provedor
GROQ_API_KEY=                    # AI SDR legado
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=          # credencial da assinatura Claude (provider claude_subscription dos agentes)
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Arquivos e runtime ──────────────────────────────────────────────────────
UPLOADS_DIR=                     # default: <app>/public/uploads (volume no compose)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser   # geração de PDF no container

# ─── Seed e testes (nunca em produção) ───────────────────────────────────────
SEED_PASSWORD=                   # senha dos usuários criados pelo seed
SEED_SAMPLE_DATA=                # "1" popula dado de exemplo
ACEITE_MANTER=                   # "1" faz os scripts de aceite NÃO limparem o cenário criado

# ─── Callface AI (SaaS, somente leitura) ─────────────────────────────────────
# O adapter fala com o banco do SaaS em modo leitura; ver a trava
# `callface-ai-somente-leitura`.
CALLFACE_AI_DATABASE_URL=        # sem isto o hub mostra a integração como não configurada
CALLFACE_AI_POOL_MAX=            # default no código; 1 em script, para não abrir pool longo
CALLFACE_AI_TIMEOUT_MS=          # default no código

# ─── Meta: identificador do dataset da CAPI ──────────────────────────────────
META_DATASET_ID=                 # sem ele a entrega de conversão sai como "sem_credencial"

# ─── Documenso (assinatura de contrato, compose próprio em infra/) ───────────
DOCUMENSO_PUBLIC_URL=
DOCUMENSO_DB_USER=
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_DB_NAME=
DOCUMENSO_NEXTAUTH_SECRET=       # openssl rand -hex 32
DOCUMENSO_ENCRYPTION_KEY=        # openssl rand -hex 32
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
DOCUMENSO_SIGNING_PASSPHRASE=

# ─── Chaves de virada (ligam caminho novo sem redeploy) ──────────────────────
POSVENDA_CANONICO=               # "1" faz o pós-venda ler o modelo canônico
NEXT_PUBLIC_POSVENDA_CANONICO=   # o mesmo, para o lado do navegador
STRIPE_WRITEBACK_ENABLED=        # "1" permite ESCRITA de volta no Stripe pelo webhook
STORAGE_REQUIRE_OBJECT_STORAGE=  # "1" recusa gravar arquivo em disco local

# ─── WhatsApp (wuzapi) ───────────────────────────────────────────────────────
WUZAPI_GLOBAL_ENCRYPTION_KEY=    # lido pelo compose, não pelo código da aplicação

# ─── Verificação de telas (checar-rotas-onface) ──────────────────────────────
BASE=                            # default http://localhost:3000
API_BASE=                        # default http://localhost:$API_PORT (o Hono)

# ─── Catraca de arquitetura (cor-tem-nome.test.ts) ───────────────────────────
ATUALIZAR_CATRACA=               # "1" reaprova o teto depois de REDUZIR o número
