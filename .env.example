# ═══════════════════════════════════════════
# Scott Studio | CRM — Environment Variables
# ═══════════════════════════════════════════

# Ambiente
NODE_ENV=production
APP_PORT=3000
COMPOSE_PROJECT_NAME=scott-studio-crm

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB_NAME
DB_NAME=scottstudio_crm
DB_USER=scottstudio
DB_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379

# Auth (NextAuth v5)
AUTH_SECRET=    # gerar com: openssl rand -base64 32
AUTH_URL=https://crm.scottstudio.com.br
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://crm.scottstudio.com.br

# ─── Scott Studio: Groq (LP Analysis + SDR) ───
GROQ_API_KEY=

# ─── Scott Studio: n8n SDR Agent ───
N8N_WEBHOOK_PRIMEIRO_CONTATO=https://n8n.scottdev.com.br/webhook/primeiro-contato

# ─── Scott Studio: Evolution API (WhatsApp) ───
# Alternativa ao UaZAPI — já configurado na VPS
EVOLUTION_API_URL=https://evolution.scottdev.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=scott-studio

# WhatsApp (WuzAPI — opcional, migrar depois)
UAZAPI_PORT=8013
UAZAPI_BASE_URL=http://wuzapi:8080
UAZAPI_API_KEY=
UAZAPI_WEBHOOK_URL=
UAZAPI_WEBHOOK_SECRET=
UAZAPI_SESSION_NAME=
WUZAPI_GLOBAL_ENCRYPTION_KEY=    # gerar com: openssl rand -hex 32
WUZAPI_ADMIN_TOKEN=               # gerar com: openssl rand -hex 16

# Email
EMAIL_ENCRYPTION_KEY=    # gerar com: openssl rand -hex 32

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Outlook OAuth — usado por E-mail (Mail.ReadWrite/Send) e
# Calendário (Calendars.ReadWrite: busy times + criação real de evento com
# Teams). Mesmo par client id/secret, mesmo fluxo de conexão em ambos.
# ATENÇÃO: MICROSOFT_CLIENT_SECRET é secret real compartilhado com produção
# (ver CLAUDE.md) — nunca gerar token novo com esse valor em ambiente local.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Meta Conversions API (opcional)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
