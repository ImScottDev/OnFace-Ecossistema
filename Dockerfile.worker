# Worker (BullMQ), construído a partir da RAIZ do repositório.
#
# Mesmo defeito do `Dockerfile`, mesma causa: `app/package.json` declara os nove
# `@onface/*` como `workspace:*`, o `npm ci` não entende esse protocolo, e o
# contexto `./app` deixava `packages/` fora da imagem. Provado no CP63:
#
#     npm error code EUNSUPPORTEDPROTOCOL
#     npm error Unsupported URL Type "workspace:": workspace:*
#
# Os três containers do CRM (app, api, worker) morriam no mesmo `npm ci`.
FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

COPY . .
RUN pnpm install --frozen-lockfile

# `--packages=external` deixa as dependências em `node_modules` em vez de
# embutir, e é por isso que o runner precisa levar o workspace junto: os
# `@onface/*` são symlinks de `app/node_modules/@onface/*` para `packages/`, e
# só resolvem se a árvore relativa entre os dois for preservada.
# `pnpm dlx` com versão fixa, no lugar do `npm install --no-save esbuild` do
# Dockerfile antigo: o esbuild não é dependência declarada do projeto, só
# entra como transitiva, e não fica exposto como binário no PATH do app.
# Os nove `@onface/*` são EMBUTIDOS, e não externos.
#
# `--packages=external` externaliza tudo que vem de `node_modules`, e os do
# workspace iam junto. A imagem construía e o container morria na primeira
# importação:
#
#     Error [ERR_MODULE_NOT_FOUND]: Cannot find module
#     '/repo/packages/domain/acquisition/commands/registrar-entrada'
#
# Os pacotes são TypeScript puro, sem build próprio (SPEC §34). O Next resolve
# isso com `transpilePackages`; aqui, quem resolve é o alias, que tira o import
# de "bare" e faz o esbuild compilar o pacote para dentro do bundle. Medido: 0
# ocorrências de `@onface/` no bundle e o domínio presente.
RUN cd app && pnpm dlx esbuild@0.28.2 src/worker/index.ts \
    --bundle --platform=node --format=esm --outdir=dist \
    --packages=external --alias:@=./src --target=node22 \
    --alias:@onface/acquisition=../packages/domain/acquisition/index.ts \
    --alias:@onface/catalog=../packages/domain/catalog/index.ts \
    --alias:@onface/identity=../packages/domain/identity/index.ts \
    --alias:@onface/sales=../packages/domain/sales/index.ts \
    --alias:@onface/integrations-callface-ai=../packages/integrations/callface-ai/index.ts \
    --alias:@onface/integrations-meta=../packages/integrations/meta/index.ts \
    --alias:@onface/platform-database=../packages/platform/database/index.ts \
    --alias:@onface/platform-events=../packages/platform/events/index.ts \
    --alias:@onface/platform-storage=../packages/platform/storage/index.ts

FROM node:22-alpine AS runner
# ffmpeg (áudio) + chromium (PDF de proposta via puppeteer)
RUN apk add --no-cache ffmpeg chromium nss freetype harfbuzz ca-certificates ttf-freefont
WORKDIR /repo
ENV NODE_ENV=production
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# `packages/` NÃO vem: o domínio já está dentro do bundle. Os dois
# `node_modules` vêm porque o pnpm liga o do app ao da raiz por symlink, e levar
# só um deixaria as dependências externas sem resolver.
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/app/node_modules ./app/node_modules
COPY --from=builder /repo/app/dist ./app/dist
COPY --from=builder /repo/app/package.json ./app/

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker --ingroup nodejs
RUN mkdir -p /repo/app/public/uploads && chown -R worker:nodejs /repo/app/public
USER worker
CMD ["node", "app/dist/index.js"]
