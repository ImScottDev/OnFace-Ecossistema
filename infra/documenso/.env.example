DOCUMENSO_DB_USER=documenso
DOCUMENSO_DB_PASSWORD=change-me
DOCUMENSO_DB_NAME=documenso
DOCUMENSO_NEXTAUTH_SECRET=change-me
DOCUMENSO_ENCRYPTION_KEY=change-me-at-least-32-characters
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=change-me-at-least-32-characters
DOCUMENSO_PUBLIC_URL=http://localhost:3500
DOCUMENSO_DISABLE_SIGNUP=true
DOCUMENSO_SIGNING_PASSPHRASE=change-me

# Desenvolvimento usa Mailpit por padrao. Para entrega real, informe um dos
# transportes documentados pelo Documenso, sem versionar a credencial.
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=mailpit
DOCUMENSO_SMTP_PORT=1025
DOCUMENSO_SMTP_SECURE=false
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_PASSWORD=
DOCUMENSO_SMTP_FROM_NAME=Callface Contratos
DOCUMENSO_SMTP_FROM_ADDRESS=contratos@callface.io
# Para o transporte "resend", use DOCUMENSO_RESEND_API_KEY fora do Git.
