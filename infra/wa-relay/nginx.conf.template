events {}
http {
  resolver 127.0.0.11 valid=10s ipv6=off;
  log_format rele '$time_iso8601 req_bytes=$request_length status=$status antigo=$upstream_status';
  access_log /dev/stdout rele;
  server {
    listen 8080;
    client_max_body_size 50m;
    location / {
      mirror /mirror;
      mirror_request_body on;
      set $antigo http://callface-crm-api:3001;
      proxy_pass $antigo/api/whatsapp/webhook;
      proxy_http_version 1.1;
      proxy_set_header Host crm.callface.io;
      proxy_set_header Content-Type $content_type;
      proxy_set_header x-hmac-signature $http_x_hmac_signature;
      proxy_connect_timeout 5s;
    }
    location = /mirror {
      internal;
      set $novo http://callface-crm2-dev-api:3001;
      proxy_pass $novo/api/whatsapp/webhook?secret=__UAZAPI_WEBHOOK_SECRET__;
      proxy_http_version 1.1;
      proxy_set_header Host dev.crm.callface.io;
      proxy_set_header Content-Type $content_type;
      proxy_set_header x-hmac-signature $http_x_hmac_signature;
      proxy_connect_timeout 3s;
      proxy_read_timeout 10s;
    }
  }
}
